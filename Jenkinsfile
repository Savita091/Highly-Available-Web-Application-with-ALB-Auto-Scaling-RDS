pipeline
{
  agents any
  stages
  {
    stage ('Hello')
    {
      steps
      {
        echo ('Hello from jenkins pipeline!')
      }
    }
    stage ('Build')
    {
      steps
      {
        echo ('Building the application')
      }
    }
    stage ('Test')
    {
      steps
      {
        echo ('Testing the application')
      }
    }
  }
}
